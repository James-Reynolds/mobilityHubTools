	journal = {Information Systems Journal},
	keywords = {Case Study Research Research Methods Pluralism},
	number = {3},
	pages = {227-242},
	st = {Case study research: a multi‐faceted research approach for IS},
	title = {Case study research: a multi‐faceted research approach for IS},
	volume = {6},
	year = {1996},
	bdsk-url-1 = {https://doi.org/10.1111/j.1365-2575.1996.tb00015.x}}

@article{Dyer:1991aa,
	abstract = {Eisenhardt (1989) presented an approach to building theory using case studies that summarized a hybrid form of case research. Her approach is paradoxical because, although its purported purpose is theory generation, it includes many of the attributes of hypothesis-testing research. It delivers almost ready-to-test hypotheses based rich qualitative insights, but it focuses so much attention on the constructs developed that the context is often missed. It is feared that this form of case research will not create an examplar, that is, a story against which researchers can compare their experiences and gain rich insights. It is shown that Eisenhardt's approach misses some of the strengths of the classic case study method. In response, Eisenhardt argues that the many classic case studies are fundamentally multiple-case studies, employ the comparative multiple-case logic of replication, and rest on rigorous methods.},
	author = {Dyer, W. and Wilkins, Alan and Eisenhardt, Kathleen},
	date-added = {2025-12-16 15:27:54 +1100},
	date-modified = {2025-12-16 15:27:54 +1100},
	id = {686},
	isbn = {03637425},
	journal = {Academy of Management. The Academy of Management Review},
	keywords = {Research Organizational Behavior Organization Theory Critiques Comparative Studies Case Studies Experimental/Theoretical Treatment},
	number = {3},
	pages = {613},
	st = {Better Stories, Not Better Constructs, to Generate Better Theory: A Rejoinder to Eisenhardt Better Stories and Better Constructs: The Case for Rigor and Comparative Logic},
	title = {Better Stories, Not Better Constructs, to Generate Better Theory: A Rejoinder to Eisenhardt Better Stories and Better Constructs: The Case for Rigor and Comparative Logic},
	volume = {16},
	year = {1991}}

@article{Eisenhardt:1989aa,
	abstract = {A description is provided of the process of inducting theory using case studies - from specifying the research questions to reaching closure. Some features of the process, such as definition of the problem and validation of the construct, are similar to hypothesis-testing research. Others, such as within-case analysis and replication logic, are unique to the inductive, case-oriented process. In general, the process described here is highly iterative and is tightly linked to data. This research approach is particularly appropriate in new topic areas. Resulting theories are often novel, empirically valid, and testable. Framebreaking insights, the tests of a good theory, and convincing grounding in evidence are the key criteria for evaluating this type of research.},
