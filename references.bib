	number = {4},
	pages = {329},
	st = {Qualitative case studies in operations management: Trends, research outcomes, and future research implications},
	title = {Qualitative case studies in operations management: Trends, research outcomes, and future research implications},
	volume = {29},
	year = {2011}}

